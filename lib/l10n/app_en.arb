{
  "@@locale": "en",

  "appTitle": "Oddlet-!",
  "@appTitle": {
    "description": "Name of the app as the operating system shows it, for example in the task switcher. NEVER TRANSLATE THIS. The app is called Oddlet-! in every language, and so is the wordmark drawn on screen. The exclamation mark is part of the name, not punctuation."
  },

  "eggLabel": "Egg",
  "@eggLabel": {
    "description": "Accessibility label for the egg on the home screen. Screen readers announce this in place of the 3D shell."
  },

  "eggHint": "Tap to touch it, drag to turn it, press and hold to open it",
  "@eggHint": {
    "description": "Accessibility hint listing everything that can be done with the egg, including how to open it. Says nothing about what the egg will become; how to operate the app is not a spoiler."
  },

  "eggHoldToOpen": "hold to open",
  "@eggHoldToOpen": {
    "description": "Shown under an unopened egg. The only instruction in the app: without it there is no way to discover that a long press opens the egg."
  },

  "revealNew": "NEW",
  "@revealNew": {
    "description": "Badge over a creature the user has never found before. Kept in English in every language, like the rarity tiers and the wordmark."
  },

  "introLine1": "An egg showed up.",
  "@introLine1": {
    "description": "First line of the opening. The whole opening sets a mood and must never hint at how to obtain anything; the app is built on the user working that out."
  },
  "introLine2": "Nobody knows what it turns into.",
  "@introLine2": {
    "description": "Second line of the opening. See introLine1."
  },
  "introLine3": "That part is on you.",
  "@introLine3": {
    "description": "Third line of the opening. Says that actions matter without saying which ones. See introLine1."
  },

  "introContinue": "tap to start",
  "@introContinue": {
    "description": "Prompt after the opening has finished, telling the user how to leave it."
  },

  "shareTagline": "what will yours turn into?",
  "@shareTagline": {
    "description": "Brand line on the share card. It asks the question the card exists to provoke and must never come close to answering it."
  },

  "revealShare": "Share",
  "@revealShare": {
    "description": "Button that turns the newly hatched creature into a picture the user can post. The picture never says how the creature was obtained."
  },

  "revealDismiss": "tap to keep going",
  "@revealDismiss": {
    "description": "Prompt under a newly hatched creature, telling the user how to leave the reveal."
  },

  "rarityCommon": "COMMON",
  "@rarityCommon": {
    "description": "Rarity tier. The six tier names are treated as brand terms and are left in English in every language, the way the Oddlet-! wordmark is. Translate only if the whole tier scheme is being localized."
  },
  "rarityUncommon": "UNCOMMON",
  "@rarityUncommon": {
    "description": "Rarity tier. See rarityCommon."
  },
  "rarityRare": "RARE",
  "@rarityRare": {
    "description": "Rarity tier. See rarityCommon."
  },
  "rarityEpic": "EPIC",
  "@rarityEpic": {
    "description": "Rarity tier. See rarityCommon."
  },
  "rarityLegendary": "LEGENDARY",
  "@rarityLegendary": {
    "description": "Rarity tier. See rarityCommon."
  },
  "raritySecret": "SECRET",
  "@raritySecret": {
    "description": "Rarity tier. See rarityCommon."
  },

  "creaturePlainChick": "Plain Chick",
  "@creaturePlainChick": {
    "description": "Creature name. Never hint at how it was obtained: the user is meant to work that out."
  },
  "creatureSleepyChick": "Sleepy Chick",
  "@creatureSleepyChick": {
    "description": "Creature name. See creaturePlainChick."
  },
  "creatureDizzyChick": "Dizzy Chick",
  "@creatureDizzyChick": {
    "description": "Creature name. See creaturePlainChick."
  },
  "creatureAngryChick": "Angry Chick",
  "@creatureAngryChick": {
    "description": "Creature name. See creaturePlainChick."
  },
  "creatureGhostChick": "Ghost Chick",
  "@creatureGhostChick": {
    "description": "Creature name. See creaturePlainChick."
  },
  "creatureStaticChick": "Static Chick",
  "@creatureStaticChick": {
    "description": "Creature name. See creaturePlainChick."
  },
  "creatureStormChick": "Storm Chick",
  "@creatureStormChick": {
    "description": "Creature name. See creaturePlainChick."
  },
  "creatureDawnRunner": "Dawn Runner",
  "@creatureDawnRunner": {
    "description": "Creature name. See creaturePlainChick."
  },
  "creatureTheQuietOne": "The Quiet One",
  "@creatureTheQuietOne": {
    "description": "Creature name for the secret creature. See creaturePlainChick."
  },

  "accountLocalOnly": "this collection only exists on this phone",
  "@accountLocalOnly": {
    "description": "Shown above the collection while the user is still on an anonymous account, explaining what they stand to lose."
  },
  "accountConnect": "keep it",
  "@accountConnect": {
    "description": "Button that starts linking a real account to the anonymous one."
  },
  "accountSheetTitle": "keep your collection",
  "@accountSheetTitle": {
    "description": "Heading of the sheet offering ways to sign in."
  },
  "accountSheetBody": "connect an account and it follows you to a new phone",
  "@accountSheetBody": {
    "description": "Explains why signing in is worth it. Says nothing about features it unlocks; the reason is not losing what you have."
  },
  "accountWithGoogle": "continue with Google",
  "@accountWithGoogle": { "description": "Sign-in button." },
  "accountWithApple": "continue with Apple",
  "@accountWithApple": { "description": "Sign-in button, iOS only." },
  "accountLinked": "done. it is yours now",
  "@accountLinked": { "description": "Shown after an account is linked successfully." },
  "accountSwitched": "signed in to an account you already had. what you found before signing in is not on it",
  "@accountSwitched": {
    "description": "Shown when the chosen account already existed, so linking was impossible and the user was signed into it instead. Must be honest that the anonymous collection did not come along."
  },
  "accountFailed": "could not connect that account",
  "@accountFailed": { "description": "Shown when signing in failed for a reason other than the user cancelling." },

  "collectionTitle": "COLLECTION",
  "@collectionTitle": {
    "description": "Heading of the screen listing every creature found so far."
  },

  "collectionOpen": "Open collection",
  "@collectionOpen": {
    "description": "Accessibility label for the button that opens the collection from the home screen."
  },

  "collectionClose": "Close collection",
  "@collectionClose": {
    "description": "Accessibility label for the button that leaves the collection."
  },

  "collectionProgress": "{found} of {total} found",
  "@collectionProgress": {
    "description": "How much of the season the user has filled in. Shown under the collection heading.",
    "placeholders": {
      "found": { "type": "int" },
      "total": { "type": "int" }
    }
  },

  "collectionUndiscovered": "Not found yet",
  "@collectionUndiscovered": {
    "description": "Accessibility label for an empty slot. Screen reader users must not be told more than sighted users, so this never hints at what the creature is or how to get it."
  },

  "collectionFoundCount": "{count, plural, =1{Found once} other{Found {count} times}}",
  "@collectionFoundCount": {
    "description": "Accessibility detail for a creature the user has found, read after its name. A plural because a first find is the common case and 'Found 1 times' is wrong in English before it is wrong anywhere else.",
    "placeholders": {
      "count": { "type": "int" }
    }
  },

  "homeNextEgg": "come back tomorrow for a new one",
  "@homeNextEgg": {
    "description": "Shown where the egg was, once today's has been opened. Says nothing about what was inside."
  },

  "dialogDismiss": "got it",
  "@dialogDismiss": {
    "description": "The only button on a message popup. Closes it."
  },

  "nameItButton": "name it",
  "@nameItButton": {
    "description": "Button on the reveal screen for a creature nobody has named. Starts naming it."
  },
  "nameItTitle": "nobody has named this one",
  "@nameItTitle": {
    "description": "Heading of the naming sheet. States the fact that makes naming worth doing."
  },
  "nameItBody": "what you call it is what everyone who finds it will see",
  "@nameItBody": {
    "description": "Why the name matters: it is what every later finder sees. Never hints at how the creature was obtained."
  },
  "nameItField": "name",
  "@nameItField": {
    "description": "Label of the field the creature name is typed into."
  },
  "nameItHandle": "nickname",
  "@nameItHandle": {
    "description": "Label of the field the nickname is typed into. Only shown to someone who has not set one."
  },
  "nameItHandleHint": "signed next to the name. not your real one",
  "@nameItHandleHint": {
    "description": "Under the nickname field. Warns against using a real name, since strangers read it."
  },
  "nameItSubmit": "register",
  "@nameItSubmit": {
    "description": "Button that sends the name to the server."
  },
  "nameItLater": "not now",
  "@nameItLater": {
    "description": "Button that leaves the naming sheet without naming. Leads to the confirmation."
  },
  "nameItDone": "it is {name} now",
  "@nameItDone": {
    "description": "Shown once the name is registered.",
    "placeholders": {
      "name": {
        "type": "String"
      }
    }
  },
  "namePassTitle": "really leave it nameless?",
  "@namePassTitle": {
    "description": "Heading of the confirmation shown when leaving without naming."
  },
  "namePassBody": "the next person to find it gets the chance instead. there is no going back",
  "@namePassBody": {
    "description": "Says what is lost by not naming: the chance goes to the next finder and does not come back. Asked once only; a second ask would be nagging."
  },
  "namePassConfirm": "pass it on",
  "@namePassConfirm": {
    "description": "Button confirming the chance is given up."
  },
  "namePassBack": "let me name it",
  "@namePassBack": {
    "description": "Button returning to naming."
  },
  "nameDiscoveredBy": "first found by {handle}",
  "@nameDiscoveredBy": {
    "description": "Credit line under a creature somebody else named. The handle is a nickname, never an account name.",
    "placeholders": {
      "handle": {
        "type": "String"
      }
    }
  },
  "nameDiscoveredByYou": "you named this one",
  "@nameDiscoveredByYou": {
    "description": "Credit line under a creature the reader named."
  },
  "nameErrorTooShort": "too short",
  "@nameErrorTooShort": {
    "description": "Naming refused: the name is shorter than two characters."
  },
  "nameErrorTooLong": "too long",
  "@nameErrorTooLong": {
    "description": "Naming refused: the name is longer than twenty characters."
  },
  "nameErrorBadCharacters": "letters and numbers only",
  "@nameErrorBadCharacters": {
    "description": "Naming refused: something outside letters, digits and the joiners a name may use."
  },
  "nameErrorRepeats": "you held a key down",
  "@nameErrorRepeats": {
    "description": "Naming refused: one character repeated past the point of being a name."
  },
  "nameErrorBlocked": "not that one",
  "@nameErrorBlocked": {
    "description": "Naming refused by the word list. Deliberately vague: naming the rule would explain how to get around it."
  },
  "nameErrorTaken": "another creature already has that name",
  "@nameErrorTaken": {
    "description": "Naming refused: some other creature already carries that name."
  },
  "nameErrorAlreadyNamed": "somebody named it first",
  "@nameErrorAlreadyNamed": {
    "description": "Naming refused: somebody named this creature first. There is no second try at this one."
  },
  "nameErrorHandle": "have another look at the nickname",
  "@nameErrorHandle": {
    "description": "Naming refused because of the nickname rather than the name."
  },
  "nameErrorNeedsAccount": "connect an account to name it",
  "@nameErrorNeedsAccount": {
    "description": "Naming refused to an anonymous account. A name everyone lives with belongs to someone who can be asked about it."
  },
  "nameErrorUnreachable": "cannot reach it right now. try in a moment",
  "@nameErrorUnreachable": {
    "description": "The naming server could not be reached."
  },
  "nameErrorUnknown": "could not register that name",
  "@nameErrorUnknown": {
    "description": "Naming failed for a reason the app has no better words for."
  },

  "signInTitle": "you need an account to start",
  "@signInTitle": {
    "description": "Heading of the screen shown before anything else. The app does not start without an account."
  },
  "signInBody": "your collection lives on it, so it follows you to a new phone",
  "@signInBody": {
    "description": "Why an account is asked for at all: the collection is attached to it. Never mentions features it unlocks."
  },
  "signInEmail": "email",
  "@signInEmail": {
    "description": "Label of the email field."
  },
  "signInPassword": "password",
  "@signInPassword": {
    "description": "Label of the password field."
  },
  "signInContinue": "continue",
  "@signInContinue": {
    "description": "Button that signs in with the typed address, creating the account if it is new. One button, because whether the address has been here before is something the server already knows."
  },
  "signInOr": "or",
  "@signInOr": {
    "description": "Divider between the provider buttons and the email form."
  },
  "signInErrorEmail": "that is not an email address",
  "@signInErrorEmail": {
    "description": "The typed address is not an address."
  },
  "signInErrorPassword": "that password is too short",
  "@signInErrorPassword": {
    "description": "The typed password is shorter than the backend will accept."
  },
  "signInErrorWrong": "that address exists and the password does not open it",
  "@signInErrorWrong": {
    "description": "That address already has an account and this password does not open it."
  },
  "handleTitle": "what should we call you",
  "@handleTitle": {
    "description": "Heading of the nickname step, straight after signing in."
  },
  "handleBody": "this sits next to the names you give. not your real one",
  "@handleBody": {
    "description": "Warns that the nickname is public next to any name they give, and should not be a real name."
  },
  "handleContinue": "that is me",
  "@handleContinue": {
    "description": "Button that saves the nickname and enters the app."
  },

  "accountTitle": "account",
  "@accountTitle": {
    "description": "Title of the account screen, and the tooltip of the button that opens it from the home header."
  },

  "accountSignOut": "sign out",
  "@accountSignOut": {
    "description": "Button that signs out. The account and everything on it stays; only this phone stops being signed in."
  },

  "accountDelete": "delete account",
  "@accountDelete": {
    "description": "Button that deletes the account for good. Shown in the error colour, below the explanation."
  },

  "accountDeleteExplain": "deleting your account removes your collection and your nickname. the names you gave stay — other people already call them that — but nothing says who gave them any more",
  "@accountDeleteExplain": {
    "description": "Says what deleting actually does before the button that does it. The registered names surviving is the part people would not guess, so it is stated here rather than only in the confirmation."
  },

  "accountDeleteTitle": "delete it all?",
  "@accountDeleteTitle": {
    "description": "Title of the confirmation asked before deleting an account."
  },

  "accountDeleteBody": "everything you have found goes, and there is no getting it back",
  "@accountDeleteBody": {
    "description": "Body of that confirmation. Says the two things that matter: everything goes, and it does not come back."
  },

  "accountDeleteConfirm": "delete it",
  "@accountDeleteConfirm": {
    "description": "The answer that deletes. Deliberately the plain button, not the filled one."
  },

  "accountDeleteCancel": "keep it",
  "@accountDeleteCancel": {
    "description": "The way out of the confirmation."
  },

  "accountDeleteFailed": "could not delete that right now. try again in a moment",
  "@accountDeleteFailed": {
    "description": "Shown when the delete could not be carried out. Nothing was deleted."
  }
}
