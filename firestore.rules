rules_version = '2';

// These rules are the only thing standing between the database and the open
// internet. The client config is public by design, so anyone can point a
// request at this project; what they are allowed to do is decided here.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Season and creature definitions are content, published from a trusted
    // process. The app reads them and never writes them.
    match /seasons/{seasonId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /creatures/{creatureId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Named creatures. Everyone who is signed in reads them, because a name
    // is only worth registering if the next finder sees it. Nobody writes
    // them: the naming function runs on the Admin SDK, which is not subject to
    // these rules, so "no writes" here means "the function or nothing".
    match /species/{speciesId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // The uniqueness index. Closed even to reads: it is the list of every
    // name ever taken, and nothing in the app needs to enumerate it.
    match /speciesNames/{nameKey} {
      allow read, write: if false;
    }

    // The word list. Publishing what the filter looks for would be handing
    // over the answer key.
    match /moderation/{document=**} {
      allow read, write: if false;
    }

    // A user owns exactly their own tree, and nothing else. No listing other
    // people, no reading someone else's collection.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow delete: if false;

      // Everything on this document is the user's own business except the
      // handle, which strangers see next to a name they did not choose. That
      // one goes through the same filter a name does, so it is written by the
      // function and never from here.
      allow create: if isOwner(userId)
        && !('handle' in request.resource.data);
      allow update: if isOwner(userId)
        && request.resource.data.get('handle', '') == resource.data.get('handle', '');

      // Today's egg, uploaded once it hatches.
      match /dailyEggs/{date} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
          && request.resource.data.touchCount is int
          && request.resource.data.touchCount >= 0
          && request.resource.data.touchCount <= 100000
          && request.resource.data.shakeCount is int
          && request.resource.data.shakeCount >= 0
          && request.resource.data.shakeCount <= 100000;
      }

      // What the user has found.
      //
      // A find count that only ever grows, and a first find that never moves.
      // This stops a fumbled write from rewriting history; it does not stop a
      // determined client from claiming a creature it never hatched. Making
      // that impossible needs the result decided server-side, which is out of
      // scope while there is nothing to cheat for.
      match /collection/{creatureId} {
        allow read: if isOwner(userId);
        // Not pinned to 1: a collection built up before it moved onto the
        // account arrives already counted, and refusing it would throw away
        // finds that really happened.
        allow create: if isOwner(userId)
          && request.resource.data.count is int
          && request.resource.data.count >= 1
          && request.resource.data.firstFoundAt is string;
        allow update: if isOwner(userId)
          && request.resource.data.count is int
          && request.resource.data.count > resource.data.count
          && request.resource.data.firstFoundAt == resource.data.firstFoundAt;
        allow delete: if false;
      }

      match /{other=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
